generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiKey {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  keyPrefix          String    @map("key_prefix")
  keyHash            String    @unique @map("key_hash")
  rateLimitRpm       Int       @default(60) @map("rate_limit_rpm")
  rateLimitBurst     Int       @default(20) @map("rate_limit_burst")
  maxOutputTokensCap Int       @default(4096) @map("max_output_tokens_cap")
  cacheEnabled       Boolean   @default(true) @map("cache_enabled")
  dailyCostCapUsd    Decimal?  @map("daily_cost_cap_usd") @db.Decimal(12, 4)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz
  lastUsedAt         DateTime? @map("last_used_at") @db.Timestamptz
  usageEvents        UsageEvent[]

  @@map("api_keys")
}

model UsageEvent {
  id                BigInt   @id @default(autoincrement())
  requestId         String   @unique @map("request_id")
  apiKeyId          String   @map("api_key_id") @db.Uuid
  createdAt         DateTime @map("created_at") @db.Timestamptz
  alias             String
  provider          String?
  model             String?
  stream            Boolean
  cacheHit          Boolean  @map("cache_hit")
  fallbackUsed      Boolean  @map("fallback_used")
  attempts          Int
  status            String
  httpStatus        Int      @map("http_status")
  errorCode         String?  @map("error_code")
  inputTokens       Int?     @map("input_tokens")
  outputTokens      Int?     @map("output_tokens")
  costUsd           Decimal? @map("cost_usd") @db.Decimal(12, 8)
  savedCostUsd      Decimal  @default(0) @map("saved_cost_usd") @db.Decimal(12, 8)
  latencyMs         Int      @map("latency_ms")
  upstreamLatencyMs Int?     @map("upstream_latency_ms")
  ttfbMs            Int?     @map("ttfb_ms")
  apiKey            ApiKey   @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId, createdAt])
  @@index([createdAt])
  @@map("usage_events")
}

model ProviderAttempt {
  id         BigInt   @id @default(autoincrement())
  requestId  String   @map("request_id")
  attemptNo  Int      @map("attempt_no")
  provider   String
  model      String
  outcome    String
  httpStatus Int?     @map("http_status")
  latencyMs  Int      @map("latency_ms")
  createdAt  DateTime @map("created_at") @db.Timestamptz

  @@index([provider, createdAt])
  @@index([requestId])
  @@map("provider_attempts")
}

