# Used by Docker Compose variable interpolation. Keep this file out of source
# control after copying it to deploy/.env.
POSTGRES_USER=gateway
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=gateway
DOMAIN=gateway.example.com
CERTBOT_EMAIL=ops@example.com
# Exact office/VPN address range permitted to use /admin (replace this example).
ADMIN_ALLOW_CIDR=203.0.113.0/24
